# Copiar para .env e preencher. O .env nunca vai para o git.

# Porta HTTP do backend.
PORT=3000

# Segredo aleatório do caminho do webhook: /hooks/whatsapp/<segredo>. Mínimo 32 caracteres.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_SEGREDO=

# uazapi. Só leitura. Configure ao menos uma instância.
UAZAPI_BASE_URL=
# Instância do número observador (opcional). fromMe dela nunca conta como time.
UAZAPI_INSTANCE_TOKEN=
# Números corporativos do time, separados por vírgula (letras sem acento, números e _).
# Cada um precisa de UAZAPI_TOKEN_<NOME EM MAIÚSCULAS>. fromMe dessas instâncias conta como time.
RADAR_INSTANCIAS=
UAZAPI_TOKEN_RONI_RAMOS=
# URL pública (túnel HTTPS de hostname fixo) onde a uazapi entrega o webhook. Sem barra no fim.
WEBHOOK_URL_PUBLICA=

# Supabase (service role: só no servidor, nunca no painel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Painel (página e API): autenticação básica, porque a URL do túnel é pública.
# Obrigatório quando há banco. Senha com pelo menos 16 caracteres; o usuário não pode ter ":".
PAINEL_USUARIO=
PAINEL_SENHA=
# Conta de administrador da tela de configurações (/admin: expediente, feriados e prazos). Opcional:
# sem estas duas linhas a tela fica desligada. Informe as duas ou nenhuma; senha com pelo menos 16
# caracteres; precisam ser diferentes de PAINEL_USUARIO e PAINEL_SENHA. A conta comum não entra na tela.
PAINEL_ADMIN_USUARIO=
PAINEL_ADMIN_SENHA=

# Conversas privadas: o número do cliente nunca fica em claro no banco, na API nem no painel.
# Obrigatórias quando há banco; sem elas o servidor não sobe (o erro cita só o nome da variável).
# Formato de cada uma: 32 bytes aleatórios em Base64 padrão = 44 caracteres terminando em "=".
# As duas precisam ser diferentes. Gerar cada uma no PowerShell (gerador criptográfico):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# RADAR_CHAVE_CONVERSA: HMAC-SHA256 que vira o identificador da conversa privada. Trocar depois
#   desliga as conversas privadas já cadastradas (viram conversas novas). Guarde uma cópia segura.
# RADAR_CHAVE_CIFRA: AES-256-GCM do chatid (só para a reconciliação). Perder = não dá para decifrar.
RADAR_CHAVE_CONVERSA=
RADAR_CHAVE_CIFRA=
# Número do chip observador (55 + DDD + número). Opcional: não conta nem como time nem como de fora
# ao decidir se um grupo é interno.
OBSERVADOR_NUMERO=

# Anthropic (só a partir do passo 7).
ANTHROPIC_API_KEY=
