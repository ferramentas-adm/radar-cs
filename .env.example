# Copiar para .env e preencher. O .env nunca vai para o git.

# Porta HTTP do backend.
PORT=3000

# Segredo aleatório do caminho do webhook: /hooks/whatsapp/<segredo>. Mínimo 32 caracteres.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_SEGREDO=

# uazapi (instância do número observador). Só leitura.
UAZAPI_BASE_URL=
UAZAPI_INSTANCE_TOKEN=
# URL pública (túnel HTTPS de hostname fixo) onde a uazapi entrega o webhook. Sem barra no fim.
WEBHOOK_URL_PUBLICA=

# Supabase (service role: só no servidor, nunca no painel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (só a partir do passo 7).
ANTHROPIC_API_KEY=

# Fase de descoberta: guardar o texto das mensagens em eventos_brutos? Padrão false (texto mascarado).
DESCOBERTA_GUARDAR_TEXTO=false
